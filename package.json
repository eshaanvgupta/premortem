{
  "name": "nexora",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @premortem/web dev",
    "start": "pnpm --filter @premortem/web start",
    "build": "pnpm --filter @premortem/core build && pnpm --filter @premortem/cli build && pnpm --filter @premortem/web build",
    "test": "pnpm --filter @premortem/core test && pnpm --filter @premortem/cli test",
    "test:e2e": "playwright test",
    "test:contracts": "node scripts/contracts.mjs test",
    "test:anvil": "node scripts/contracts.mjs smoke",
    "test:protocol": "node scripts/protocol-e2e.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "release": "node scripts/release.mjs",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare:mainnet": "node scripts/mainnet.mjs prepare",
    "verify:mainnet": "node scripts/mainnet.mjs verify",
    "secret:scan": "node scripts/secret-scan.mjs",
    "premortem": "pnpm --filter @premortem/cli exec tsx src/index.ts",
    "build:static": "node scripts/build-static.mjs",
    "test:deployment": "node scripts/deployment-e2e.mjs",
    "prepare:deployment": "node scripts/deployment-package.mjs",
    "build:production": "node scripts/build-static.mjs --mainnet",
    "nexora": "pnpm --filter @premortem/cli exec tsx src/index.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "eslint": "^9.39.0",
    "fast-check": "^4.3.0",
    "lighthouse": "13.6.0",
    "prettier": "^3.7.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "viem": "2.58.2",
    "vitest": "^4.0.0"
  }
}
